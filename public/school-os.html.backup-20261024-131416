/* Visible calendar button for date inputs */
.date-picker-wrap {
  display: flex;
  align-items: stretch;
  gap: 8px;
  width: 100%;
}
.date-picker-wrap input[type="date"] {
  flex: 1;
  min-width: 0;
  cursor: pointer;
}
.date-picker-button {
  flex: 0 0 48px;
  min-width: 48px;
  border: 1px solid #555b7c;
  border-radius: 10px;
  background: #272c49;
  color: #ffffff;
  font-size: 22px;
  cursor: pointer;
}
.date-picker-button:hover {
  background: #394163;
}

