document.querySelectorAll('[data-vis]').forEach(b => {
  b.onclick = () => {
    vis = b.dataset.vis;

    document.querySelectorAll('[data-vis]').forEach(x => {
      x.classList.toggle('active', x === b);
    });

    $('phoneDisplay').textContent =
      vis === 'visible'
        ? 'Demo preview: phone numbers are not included in this file.'
