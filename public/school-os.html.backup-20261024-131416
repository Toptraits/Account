<script>
const $ = id => document.getElementById(id);
const money = value =>
  '₹' + Number(value || 0).toLocaleString('en-IN', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });

let authToken = null;
let loggedInUser = null;
let otpStage = false;

let selected = null;
let sort = 'due';
let listMode = 'collect';
let payMode = 'Cash';
let vis = 'hidden';

/* =========================================================
   NOTIFICATIONS AND API REQUESTS
========================================================= */

function notify(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');

  clearTimeout(window._toastTimer);

  window._toastTimer = setTimeout(() => {
    t.classList.remove('show');
  }, 3200);
}

async function apiRequest(path, options = {}) {
  const headers = {
    Accept: 'application/json',
    'Content-Type': 'application/json',
    ...(authToken
      ? { Authorization: 'Bearer ' + authToken }
      : {}),
    ...(options.headers || {})
  };

  const response = await fetch(path, {
    ...options,
    headers,
    cache: !options.method || options.method.toUpperCase() === 'GET'
      ? 'no-store'
      : undefined
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    if (response.status === 401 && authToken) {
      authToken = null;
      loggedInUser = null;
      setScreen('login');
    }

    throw new Error(
      data.message || 'Request failed. Please try again.'
    );
  }

  return data;
}

/* =========================================================
   SCREEN NAVIGATION
========================================================= */

function setScreen(which) {
  if (which === 'accountant' && !authToken) {
    $('loginStatus').className = 'status show error';
    $('loginStatus').textContent =
      'Please sign in with your registered email address first.';

    which = 'login';
  }

  $('loginScreen').classList.toggle(
    'active',
    which === 'login'
  );

  $('accountantScreen').classList.toggle(
    'active',
    which === 'accountant'
  );

  $('showLogin').classList.toggle(
    'active',
    which === 'login'
  );

  $('showAccountant').classList.toggle(
    'active',
    which === 'accountant'
  );

  window.scrollTo({
    top: 0,
    behavior: 'smooth'
  });
}

$('showLogin').onclick = () => {
  if (authToken) {
    if (confirm('Log out of the accountant session?')) {
      logout();
    }
  } else {
    setScreen('login');
  }
};

$('showAccountant').onclick = () => {
  setScreen('accountant');
};

/* =========================================================
   OTP LOGIN
========================================================= */

function resetLogin() {
  otpStage = false;

  $('phone').readOnly = false;
  $('otp').value = '';

  $('otpWrap').style.display = 'none';
  $('otpActions').style.display = 'none';

  $('submitLogin').textContent = 'Send OTP';

  $('loginHeading').textContent = 'Welcome Back';

  $('loginSubtext').textContent =
    'Sign in using your registered email address.';

  $('loginStatus').className = 'status';
}

$('loginForm').addEventListener('submit', async e => {
  e.preventDefault();

  const phone = $('phone').value.trim();
  const otp = $('otp').value.trim();
  const status = $('loginStatus');
  const submit = $('submitLogin');

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(phone)) {
    status.className = 'status show error';
    status.textContent =
      'Enter a valid email address.';
    return;
  }

  status.className = 'status show info';

  status.textContent = otpStage
    ? 'Verifying OTP...'
    : 'Requesting OTP...';

  submit.disabled = true;

  try {
    if (!otpStage) {
      // STEP 1: Request OTP from Laravel.
      await apiRequest('/api/login/send-otp', {
        method: 'POST',
        body: JSON.stringify({
          email: phone
        })
      });

      otpStage = true;

      $('phone').readOnly = true;
      $('otpWrap').style.display = 'block';
      $('otpActions').style.display = 'flex';

      submit.textContent = 'Verify OTP';

      $('loginHeading').textContent =
        'Verify your email address';

      $('loginSubtext').textContent =
        'Enter the six-digit OTP from your configured delivery method.';

      status.className = 'status show info';

      status.textContent =
        'OTP sent to your registered email address. Check your inbox and spam folder.';

    } else {
      // STEP 2: Validate OTP input.
      if (!/^\d{6}$/.test(otp)) {
        throw new Error('Enter the six-digit OTP.');
      }

      // STEP 3: Verify OTP with Laravel.
      const data = await apiRequest(
        '/api/login/verify-otp',
        {
          method: 'POST',
          body: JSON.stringify({
            email: phone,
            otp: otp
          })
        }
      );

      // STEP 4: Store the returned token in memory.
      authToken = data.token;
      loggedInUser = data.user;

      status.className = 'status show info';
      status.textContent =
        'Login successful. Loading accountant dashboard...';

      // STEP 5: Open the authenticated dashboard.
      setScreen('accountant');

      // STEP 6: Request dashboard data from Laravel.
      try {
        await loadStudents();

        console.log(
          'Authenticated user:',
          loggedInUser
        );

        await loadDashboard();

        notify(
          'Signed in successfully. Dashboard API connected.'
        );

      } catch (dashboardError) {
        console.error(
          'Dashboard API error:',
          dashboardError
        );

        notify(
          'Login succeeded, but dashboard API failed: ' +
          dashboardError.message
        );
      }
    }

  } catch (error) {
    status.className = 'status show error';
    status.textContent = error.message;

  } finally {
    submit.disabled = false;
  }
});

// Change mobile number and restart login.
$('changeNumber').onclick = () => {
  resetLogin();
  $('loginStatus').className = 'status';
};

// Request another OTP.
$('resendOtp').onclick = async () => {
  const phone = $('phone').value.trim();
  const status = $('loginStatus');

  status.className = 'status show info';
  status.textContent = 'Requesting a new OTP...';

  try {
    await apiRequest('/api/login/send-otp', {
      method: 'POST',
      body: JSON.stringify({
        email: phone
      })
    });

    $('otp').value = '';

    status.textContent =
      'New OTP sent. Check your email inbox and spam folder.';

  } catch (error) {
    status.className = 'status show error';
    status.textContent = error.message;
  }
};

/* =========================================================
   LOGOUT
========================================================= */

async function logout() {
  try {
    if (authToken) {
      await apiRequest('/api/logout', {
        method: 'POST'
      });
    }

  } catch (error) {
    console.error('Logout API error:', error);

  } finally {
    authToken = null;
    loggedInUser = null;

    $('phone').value = '';

    resetLogin();
    setScreen('login');

    notify('Logged out.');
  }
}

/* =========================================================
   SAMPLE STUDENT DATA
   NOTE: This is preview data, not PostgreSQL data.
========================================================= */

let students = [];


function normalizeClassName(value) {
  const name = String(value || '').trim();
  if (/^\d+$/.test(name)) return 'Class ' + name;
  const match = name.match(/^class\s*(\d+)$/i);
  if (match) return 'Class ' + match[1];
  return name;
}

function populateClassFilter() {
  const select = $('classFilter');
  if (!select) return;

  const standardClasses = [
    'Baby Class', 'Nursery', 'LKG', 'UKG',
    ...Array.from({length: 10}, (_, i) => 'Class ' + (i + 1))
  ];
  const existingClasses = students.map(s => s.className);
  const extras = [...new Set(existingClasses)]
    .filter(name => name && !standardClasses.includes(name))
    .sort((a, b) => a.localeCompare(b, undefined, {numeric: true}));

  const previous = select.value || 'all';
  select.innerHTML = '<option value="all">All classes</option>';

  [...standardClasses, ...extras].forEach(name => {
    const option = document.createElement('option');
    option.value = name;
    option.textContent = name;
    select.appendChild(option);
  });

  select.value = [...select.options].some(o => o.value === previous)
    ? previous : 'all';
}




async function loadDashboard() {
  try {
    const result = await apiRequest('/api/accountant/dashboard');
    const data = result.data || result;

    const amount = value => Number(value || 0);
    const percent = value =>
      Math.max(0, Math.min(100, amount(value)));

    $('collection').textContent = money(data.today_collection);
    $('target').textContent = money(data.daily_target);
    $('stillCollect').textContent = money(data.still_to_collect);
    $('receiptsToday').textContent = String(data.receipts_today ?? 0);
    $('nextReceipt').textContent =
      data.next_receipt_number || 'Unavailable';
    $('promisedToday').textContent =
      money(data.promised_amount_today);

    const progress = percent(data.collection_progress_percent);
    $('progressFill').style.width = progress + '%';

    $('collectionInsight').textContent =
      progress.toFixed(1) + '% of today’s collection target reached. ' +
      String(data.commitments_due_today ?? 0) +
      ' payment promise(s) due today; ' +
      String(data.pending_reminders ?? 0) +
      ' reminder(s) queued.';

    $('totalOutstanding').textContent =
      money(data.total_outstanding);

    $('overdueSummary').textContent =
      money(data.overdue_outstanding) + ' overdue (' +
      amount(data.overdue_percent).toFixed(1) + '%)';

    const aging = data.aging || {};
    const buckets = [
      {
        key: 'not_yet_due',
        amountId: 'agingNotDue',
        countId: 'agingNotDueCount'
      },
      {
        key: 'overdue_0_7_days',
        amountId: 'aging0to7',
        countId: 'aging0to7Count'
      },
      {
        key: 'overdue_8_30_days',
        amountId: 'aging8to30',
        countId: 'aging8to30Count'
      },
      {
        key: 'overdue_over_30_days',
        amountId: 'agingOver30',
        countId: 'agingOver30Count'
      }
    ];

    buckets.forEach(bucket => {
      const item = aging[bucket.key] || {};
      $(bucket.amountId).textContent = money(item.amount);
      $(bucket.countId).textContent =
        String(item.student_count ?? 0) + ' students';
    });

    const total = amount(data.total_outstanding);
    const bar = $('agingBar');
    const segments = bar.querySelectorAll('span');

    buckets.forEach((bucket, index) => {
      if (segments[index]) {
        const item = aging[bucket.key] || {};
        const width = total > 0
          ? Math.max(0, amount(item.amount) / total * 100)
          : 0;
        segments[index].style.width = width + '%';
      }
    });

    console.log('Dashboard loaded from PostgreSQL:', data);
    return data;
  } catch (error) {
    const ids = [
      'collection', 'target', 'stillCollect', 'receiptsToday',
      'nextReceipt', 'promisedToday', 'totalOutstanding',
      'overdueSummary', 'agingNotDue', 'aging0to7',
      'aging8to30', 'agingOver30'
    ];

    ids.forEach(id => {
      const element = $(id);
      if (element) element.textContent = 'Unavailable';
    });

    $('collectionInsight').textContent =
      'Dashboard data could not be loaded. Please check the API and try again.';

    console.error('Unable to load dashboard data:', error);
    throw error;
  }
}

async function loadStudents() {
  const previouslySelectedId = selected?.id || null;
  const records = [];
  let page = 1;
  let lastPage = 1;

  // Fetch every page; the API limits each page to at most 100 students.
  do {
    const result = await apiRequest(
      '/api/students?per_page=100&page=' + page
    );
    records.push(...(Array.isArray(result.data) ? result.data : []));
    lastPage = Number(result.last_page || 1);
    page++;
  } while (page <= lastPage);

  students = records.map(student => {
    const fees = Array.isArray(student.fees) ? student.fees : [];
    const unpaidFees = fees.filter(fee => Number(fee.balance || 0) > 0);
    const dates = unpaidFees.map(fee => fee.due_date).filter(Boolean).sort();
    const originalDueDate = dates.length ? dates[0] : null;
    const promisedDate = student.promised_date || null;
    const schoolDate = student.school_date || new Date().toISOString().slice(0, 10);
    const dueDate = originalDueDate;
    let days = null;

    if (dueDate) {
      days = Math.floor(
        (Date.parse(schoolDate + 'T00:00:00Z') -
         Date.parse(dueDate + 'T00:00:00Z')) / 86400000
      );
    }

    return {
      dbId: Number(student.id),
      id: String(student.admission_number || student.id),
      name: student.name,
      className: normalizeClassName(student.class_name),
      family: student.parent_name || 'Parent details unavailable',
      due: Number(student.outstanding || 0),
      overdueAmount: Number(student.overdue_amount || 0),
      hasOverdue: Boolean(student.has_overdue),
      overdueDays: Number(student.overdue_days || 0),
      promiseToday: Boolean(student.promise_today),
      dueDate,
      promisedDate,
      days,
      schoolDate,
      last: 'Payment history available in student payment records',
      likely: student.promise_today ? 1 : 0
    };
  });

  populateClassFilter();

  selected = previouslySelectedId
    ? (students.find(s => s.id === previouslySelectedId) || null)
    : null;

  renderStudents();

  if (selected) {
    selectStudent(selected.id);
  }

  console.log('Students loaded from PostgreSQL:', students.length);
}

function renderStudents() {
  const q = $('topSearch').value.trim().toLowerCase();
  const selectedClass = $('classFilter')?.value || 'all';

  let rows = students.filter(s => {
    const matchesSearch = (s.name + ' ' + s.id + ' ' + s.className)
      .toLowerCase().includes(q);

    if (!matchesSearch) return false;

    if (listMode === 'collect') {
      return s.due > 0 && (s.hasOverdue || s.promiseToday);
    }

    return selectedClass === 'all' || s.className === selectedClass;
  });

  if (sort === 'due') {
    rows.sort((a, b) => b.due - a.due);
  } else if (sort === 'days') {
    rows.sort((a, b) => b.overdueDays - a.overdueDays);
  } else {
    rows.sort((a, b) => Number(b.promiseToday) - Number(a.promiseToday));
  }

  $('studentList').innerHTML = '';
  $('noStudents').style.display = rows.length ? 'none' : 'block';
  $('noStudents').textContent = listMode === 'collect'
    ? 'No students have overdue fees or a payment promise due today.'
    : 'No students matched this class and search.';

  rows.forEach(s => {
    const d = document.createElement('article');
    d.className = 'student' + (selected?.id === s.id ? ' selected' : '');

    let status = '';
    if (s.due <= 0) {
      status = '<span class="badge today">Paid</span>';
    } else if (s.promiseToday) {
      status = '<span class="badge today">Promised today</span>';
    } else if (s.hasOverdue) {
      status = `<span class="badge">${s.overdueDays} days overdue</span>`;
    } else if (s.promisedDate) {
      status = `<span class="badge today">Promised: ${new Date(s.promisedDate + 'T12:00:00').toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'})}</span>`;
    } else if (s.days !== null && s.days < 0) {
      status = `<span class="badge today">Due in ${Math.abs(s.days)} days</span>`;
    } else if (s.days === 0) {
      status = '<span class="badge today">Due today</span>';
    }

    d.innerHTML = `
      <div class="studenttop">
        <div>
          <div class="studentname">${s.name}${status}</div>
          <div class="studentmeta">
            ${s.className} · ${s.id} ·
            ${s.dueDate ? 'Due date ' + new Date(s.dueDate + 'T12:00:00').toLocaleDateString('en-GB', {day:'2-digit', month:'short'}) + ' · ' : ''}
            ${s.last}
          </div>
        </div>
        <div class="due">${money(s.due)}</div>
      </div>
      <div class="studentactions">
        <button class="actionbtn primarybtn" data-action="payment" data-id="${s.id}">Record payment</button>
        <button class="actionbtn" data-action="call" data-id="${s.id}">☎ Call parent</button>
        <button class="actionbtn" data-action="reminder" data-id="${s.id}">Send reminder</button>
      </div>
    `;
    $('studentList').appendChild(d);
  });
}

function selectStudent(id, action) {
  selected = students.find(s => s.id === id) || null;

  renderStudents();

  if (!selected) return;

  $('paymentHint').style.display = 'none';
  $('paymentFields').style.display = 'block';

  $('paymentWho').textContent =
    `${selected.name} · Class ${selected.className} · Due ${money(selected.due)}`;

  $('amount').value = selected.due;

  $('allocation').value =
    `${selected.name} (due ${money(selected.due)})`;

  $('parentWho').textContent =
    `${selected.family} · ${selected.name}, Class ${selected.className} · Due ${money(selected.due)}`;

  $('reminderWho').textContent =
    `${selected.name} · ${selected.id} · Outstanding ${money(selected.due)}`;

  $('promiseAmount').value = selected.due;

  $('phoneDisplay').textContent =
    vis === 'visible'
      ? 'Demo preview: phone numbers are not included in this file.'
      : 'Parent phone number remains hidden in this preview.';

  if (action === 'call') {
    $('parentPanel').scrollIntoView({
      behavior: 'smooth',
      block: 'nearest'
    });
  } else if (action === 'payment') {
    $('paymentPanel').scrollIntoView({
      behavior: 'smooth',
      block: 'nearest'
    });
  } else if (action === 'reminder') {
    $('sendReminder').scrollIntoView({
      behavior: 'smooth',
      block: 'nearest'
    });
  }
}

$('studentList').addEventListener('click', e => {
  const b = e.target.closest('button[data-action]');

  if (b) {
    selectStudent(b.dataset.id, b.dataset.action);
  }
});

$('topSearch').addEventListener('input', renderStudents);

document.querySelectorAll('[data-sort]').forEach(b => {
  b.onclick = () => {
    sort = b.dataset.sort;

    document.querySelectorAll('[data-sort]').forEach(x => {
      x.classList.toggle('active', x === b);
    });

    renderStudents();
  };
});

function updateListMode() {
  const classMode = listMode === 'class';
  $('classFilterWrap').style.display = classMode ? 'block' : 'none';
  $('sortButtons').style.display = classMode ? 'none' : 'flex';
  $('listDescription').textContent = classMode
    ? 'Browse students by class. Student records come from PostgreSQL.'
    : 'Students with overdue fees or a payment promise due today.';
  renderStudents();
}

document.querySelectorAll('[data-listmode]').forEach(b => {
  b.onclick = () => {
    listMode = b.dataset.listmode;
    document.querySelectorAll('[data-listmode]').forEach(x => {
      x.classList.toggle('active', x === b);
    });
    updateListMode();
  };
});

$('classFilter').addEventListener('change', renderStudents);

/* =========================================================
   PAYMENT FORM — PREVIEW ONLY
========================================================= */

document.querySelectorAll('[data-mode]').forEach(b => {
  b.onclick = () => {
    payMode = b.dataset.mode;

    document.querySelectorAll('[data-mode]').forEach(x => {
      x.classList.toggle('active', x === b);
    });

    $('utrField').style.display =
      payMode === 'Cash' ? 'none' : 'block';
