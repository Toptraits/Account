<body>
<header class="topnav">
  <div class="brand"><em>✦</em> Toptraits <span style="font-weight:500;color:#a8bad7">School OS</span></div>
  <div class="navright" role="navigation" aria-label="Preview screens">
    <button class="navbtn active" id="showLogin">Main Login</button>
    <button class="navbtn" id="showAccountant">Accountant Dashboard</button>
  </div>
</header>
<div class="hintbar">School OS · Secure email OTP login</div>

<section class="screen active" id="loginScreen">
  <div class="login-stage">
    <div class="login-card">
      <section class="login-brand">
        <div class="eyebrow">SCHOOL MANAGEMENT PLATFORM</div>
        <h1>Welcome to<br>School Platform</h1>
        <p>One intelligent platform to manage your entire school from one place.</p>
        <ul class="featurelist">
          <li>Student &amp; Staff Management</li><li>Attendance &amp; Academics</li><li>Admissions &amp; Fees</li><li>Homework &amp; Exams</li><li>AI-powered School Automation</li>
        </ul>
        <div class="login-foot">Secure access for authorised school users.</div>
      </section>
      <section class="login-form-side">
        <form class="login-form" id="loginForm">
          <div class="smallcaps">LOGIN CREDENTIALS</div>
          <h2 id="loginHeading">Welcome Back</h2>
          <p class="subtext" id="loginSubtext">Sign in using your registered email address.</p>
          <label class="fieldlabel" for="phone">Email address<span style="color:#ef4444">*</span></label>
          <div class="phonebox"><input id="phone" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="Enter your registered email address" required></div>
          <div id="otpWrap" style="display:none;margin-top:20px"><label class="fieldlabel" for="otp">Enter OTP<span style="color:#ef4444">*</span></label><input class="plaininput" id="otp" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="Enter 6-digit OTP"></div>
          <button class="primary" type="submit" id="submitLogin">Send OTP</button>
          <div id="loginStatus" class="status info"></div>
          <div id="otpActions" class="otp-actions" style="display:none"><button class="secondary" type="button" id="changeNumber">Use another email</button><button class="secondary" type="button" id="resendOtp">Resend OTP</button></div>
          <div class="helptext">Don't have access? Contact your school administrator.<br><span style="display:block;margin-top:8px">A verification code will be sent to your registered email address.</span></div>
          
        </form>
      </section>
    </div>
  </div>
</section>


<section class="screen" id="addStudentScreen">
  <div class="dash">
    <div class="dashheader">
      <div class="rolebrand">Toptraits · Student Admission</div>
      <button class="navbtn" id="backToAccountant">Back to Accountant Dashboard</button>
    </div>
    <main class="dashgrid" style="grid-template-columns:minmax(0,850px);justify-content:center">
      <section class="leftcol">
        <div class="card">
          <h2 style="margin:0 0 8px">Add Student</h2>
          <p class="sub">Enter the student's details. Fields marked * are required.</p>
          <form id="addStudentForm">
            <div class="fieldrow">
              <div class="field">
                <label for="newAdmission">Enrollment number *</label>
                <input id="newAdmission" name="admission_number" maxlength="40" required>
              </div>
              <div class="field">
                <label for="newName">Student name *</label>
                <input id="newName" name="name" maxlength="150" required>
              </div>
            </div>
            <div class="fieldrow">
              <div class="field">
                <label for="newClass">Standard / Class *</label>
                <select id="newClass" name="class_name" required>
                  <option value="">Choose class</option>
                  <option>Nursery</option><option>LKG</option><option>UKG</option>
                  <option>Class 1</option><option>Class 2</option><option>Class 3</option>
                  <option>Class 4</option><option>Class 5</option><option>Class 6</option>
                  <option>Class 7</option><option>Class 8</option><option>Class 9</option>
                  <option>Class 10</option><option>Class 11</option><option>Class 12</option>
                </select>
              </div>
              <div class="field">
                <label for="newSection">Section</label>
                <input id="newSection" name="section" maxlength="40">
              </div>
            </div>
            <div class="fieldrow">
              <div class="field">
                <label for="newFather">Father's name</label>
                <input id="newFather" name="parent_name" maxlength="150">
              </div>
              <div class="field">
                <label for="newMother">Mother's name</label>
                <input id="newMother" name="mother_name" maxlength="150">
              </div>
            </div>
            <div class="fieldrow">
              <div class="field">
                <label for="newDob">Date of birth</label>
                <input id="newDob" name="date_of_birth" type="date">
              </div>
              <div class="field">
                <label for="newMobile">Parent mobile</label>
                <input id="newMobile" name="parent_mobile" type="tel"
                       inputmode="numeric" maxlength="10" pattern="[6-9][0-9]{9}"
                       title="Enter a valid 10-digit Indian mobile number">
              </div>
            </div>
            <div class="fieldrow">
              <div class="field">
                <label for="newReligion">Religion</label>
                <input id="newReligion" name="religion" maxlength="100">
              </div>
              <div class="field">
                <label for="newCaste">Caste</label>
                <input id="newCaste" name="caste" maxlength="100">
              </div>
            </div>
            <div class="field">
              <label for="newAadhaar">Aadhaar number (12 digits, optional)</label>
              <input id="newAadhaar" name="aadhaar_number" type="password"
                     inputmode="numeric" maxlength="12" pattern="[0-9]{12}"
                     autocomplete="off">
              <div class="mutednote">Sensitive information. It is not displayed in the student list.</div>
            </div>
            <button class="copilotbtn wide" id="saveNewStudent" type="submit">Save Student to Database</button>
            <div id="addStudentStatus" class="status info" role="status" aria-live="polite"></div>
          </form>
        </div>
      </section>
    </main>
  </div>
</section>

<section class="screen" id="accountantScreen">
  <div class="dash">
    <header class="dashheader">
      <div class="rolebrand">Toptraits · Accountant</div>
      <div class="office">● Office open until 5:00 PM</div>
      <div class="searchwrap"><input id="topSearch" type="search" placeholder="Find a student or ask Copilot..." aria-label="Find a student or ask Copilot"><button class="copilotbtn" id="askCopilot">✦ Ask Copilot</button></div>
      <div class="meta" id="feesAsOn">Fees as on</div>
      <div class="seg" id="visibility"><button class="active" data-vis="hidden">Numbers hidden</button><button data-vis="masked">Masked</button><button data-vis="visible">Visible</button></div>
    </header>

    <div class="copilot-area" id="copilotArea"><div class="copilotbox"><div class="copilothead"><span>✦ Ask the AI accountant</span><button class="closebtn" id="closeCopilot" aria-label="Close Copilot response">×</button></div><div class="chatbody" id="chatBody"></div><div class="chaterror" id="chatError"></div></div></div>

    <main class="dashgrid">
      <section class="leftcol">
        
<div class="card hero">
  <div class="sub">Today's collection</div>

  <div class="big">
    <span id="collection">Loading...</span>
    <small>of <span id="target">Loading...</span> target</small>
  </div>

  <div class="progress"><i id="progressFill"></i></div>

  <div class="kpis">
    <div class="kpi">
      <span>Still to collect</span>
      <b id="stillCollect">Loading...</b>
    </div>
    <div class="kpi">
      <span>Receipts today</span>
      <b id="receiptsToday">Loading...</b>
    </div>
    <div class="kpi">
      <span>Next receipt no.</span>
      <b id="nextReceipt">Loading...</b>
    </div>
    <div class="kpi">
      <span>Promised for today</span>
      <b id="promisedToday">Loading...</b>
    </div>
  </div>

  <div class="suggestion" id="collectionInsight">
    Loading collection analytics from the database...
  </div>
</div>

        
<div class="card">
  <div class="agingtop">
    <span>Outstanding today: <b id="totalOutstanding">Loading...</b></span>
    <span class="sub" id="overdueSummary">Loading...</span>
  </div>

  <div class="agingbar" id="agingBar">
    <span style="width:0%"></span>
    <span style="width:0%"></span>
    <span style="width:0%"></span>
    <span style="width:0%"></span>
  </div>

  <div class="aginglegend">
    <div class="sub">
      🔹 Not yet due
      <b id="agingNotDue">Loading...</b>
      <span id="agingNotDueCount">— students</span>
    </div>
    <div class="sub">
      🟠 0–7 days overdue
      <b id="aging0to7">Loading...</b>
      <span id="aging0to7Count">— students</span>
    </div>
    <div class="sub">
      🟠 8–30 days overdue
      <b id="aging8to30">Loading...</b>
      <span id="aging8to30Count">— students</span>
    </div>
    <div class="sub">
      🔴 Over 30 days overdue
      <b id="agingOver30">Loading...</b>
      <span id="agingOver30Count">— students</span>
    </div>
  </div>
</div>

        <div class="card">
          <div class="sectionhead"><div class="seg"><button class="active" data-listmode="collect">Collect first</button><button data-listmode="class">Class view</button><button type="button" id="addStudentFromList">Add Student</button></div></div>
          <div class="sortrow"><span class="sub" id="listDescription">Top students by highest due. Fees only.</span><div class="seg" id="sortButtons"><button class="active" data-sort="due">Highest due</button><button data-sort="days">Longest overdue</button><button data-sort="likely">Likely to pay today</button></div></div>
          <div class="field" id="classFilterWrap" style="display:none;margin-top:10px">
