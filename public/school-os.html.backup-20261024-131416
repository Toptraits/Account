          ? 'Parent phone number would be masked in the real application.'
          : 'Parent phone number remains hidden in this preview.';

    notify('Contact visibility preview changed to ' + vis + '.');
  };
});

$('postPayment').onclick = async () => {
  if (!selected) return notify('Select a student first.');
  if (!selected.dbId) return notify('Student database ID is missing. Reload students.');

  const amount = Number($('amount').value);
  if (!Number.isFinite(amount) || amount <= 0) {
    return notify('Enter a valid payment amount.');
  }
  if (amount > Number(selected.due) + 0.0001) {
    return notify('Payment cannot exceed outstanding balance of ₹' +
      Number(selected.due).toLocaleString('en-IN') + '.');
  }

  const reference = $('utr').value.trim();
  if (payMode !== 'Cash' && !/^\d{12}$/.test(reference)) {
    return notify('Enter the 12-digit transaction reference for ' + payMode + '.');
  }

  const receivedAt = $('receivedDate').value;
  if (!receivedAt) return notify('Choose the date money was received.');

  const promisedDate = $('nextPaymentDate').value;
  if (amount < Number(selected.due) - 0.0001 && !promisedDate) {
    return notify('Choose the next promised payment date for the remaining balance.');
  }
  if (promisedDate && promisedDate < new Date().toISOString().slice(0, 10)) {
    return notify('The promised payment date cannot be in the past.');
  }

  const method = payMode === 'Bank' ? 'Bank transfer' : payMode;
  const btn = $('postPayment');
  btn.disabled = true;
  btn.textContent = 'Saving payment…';

  try {
    const result = await apiRequest('/api/payments', {
      method: 'POST',
      body: JSON.stringify({
        student_id: selected.dbId,
        amount: amount,
        method: method,
        reference: reference || null,
        received_at: receivedAt,
        promised_date: promisedDate || null
      })
    });

    const payment = result.data || {};
    notify('Payment saved successfully. Receipt: ' +
      (payment.receipt_number || 'created') + '.');

    $('utr').value = '';
    $('nextPaymentDate').value = '';

    // Reload the latest database balances and dashboard totals.
    await loadStudents();
    await loadDashboard();

    // Try to show the receipt using the backend's receipt endpoint.
    if (payment.id) {
      try {
        const receiptResult = await apiRequest(
          '/api/payments/' + payment.id + '/receipt'
        );
        const receipt = receiptResult.data || {};
        const lines = [
          'Receipt: ' + (receipt.receipt_number || payment.receipt_number || ''),
          'Student: ' + (receipt.student_name || ''),
          'Admission no.: ' + (receipt.admission_number || ''),
          'Amount received: ₹' + Number(receipt.amount || payment.amount || amount)
            .toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2}),
          'Method: ' + (receipt.method || method),
          'Date: ' + (receipt.received_at || receivedAt)
        ];
        alert(lines.join('\n'));
      } catch (receiptError) {
        notify('Payment saved, but receipt could not be loaded: ' + receiptError.message);
      }
    }
  } catch (error) {
    notify('Payment was not saved: ' + error.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Record payment';
  }
};

