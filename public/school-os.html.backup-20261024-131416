========================================================= */

function answerFor(q) {
  const t = q.toLowerCase();

  if (/today.?s collection|collection today|collected today/.test(t)) {
    return "Today's collection in this preview is ₹0 against a ₹4,50,000 target. This is illustrative data; the live answer must come from the backend.";
  }

  const s = students.find(x =>
    t.includes(x.id.toLowerCase()) ||
    t.includes(x.name.toLowerCase())
  );

  if (s) {
    return `${s.name} (${s.id}) has ${money(s.due)} outstanding in this UI preview. Fee due date: ${s.dueDate}; ${
      s.days > 0
        ? s.days + ' days overdue'
        : s.days === 0
          ? 'due today'
          : 'due in ' + Math.abs(s.days) + ' days'
    }. This is illustrative data, not a live backend response.`;
  }

  if (/overdue|outstanding|balance|due amount|fees/.test(t)) {
    return 'This preview contains illustrative fee records only. Connect the backend API to calculate an accurate total for this question.';
  }

  return 'Copilot UI preview is ready, but this standalone HTML has no connection to the AI backend. The live request/response integration remains to be connected.';
}

