$('addStudentForm').addEventListener('submit', async event => {
  event.preventDefault();

  if (!authToken) {
    notify('Your session has expired. Please log in again.');
    showScreen('loginScreen', 'showLogin');
    return;
  }

  const form = event.currentTarget;
  if (!form.reportValidity()) return;

  const value = id => $(id).value.trim();
  const payload = {
    admission_number: value('newAdmission'),
    name: value('newName'),
    class_name: value('newClass'),
    section: value('newSection') || null,
    parent_name: value('newFather') || null,
    mother_name: value('newMother') || null,
    date_of_birth: value('newDob') || null,
    parent_mobile: value('newMobile') || null,
    religion: value('newReligion') || null,
    caste: value('newCaste') || null,
    aadhaar_number: value('newAadhaar') || null
  };

  const button = $('saveNewStudent');
  const status = $('addStudentStatus');
  button.disabled = true;
  button.textContent = 'Saving...';
  status.className = 'status info show';
  status.textContent = 'Saving student to PostgreSQL...';

  try {
    const result = await apiRequest('/api/students', {
      method: 'POST',
      body: JSON.stringify(payload)
    });

    status.className = 'status success show';
    status.textContent = result.message || 'Student saved successfully.';
    notify('Student saved to the database.');

    form.reset();

    await loadStudents();
    await loadDashboard();
  } catch (error) {
    status.className = 'status error show';
    const errors = error?.errors
      ? Object.values(error.errors).flat().join(' ')
      : '';
    status.textContent = errors || error.message || 'Could not save student. Please check the details and try again.';
  } finally {
    button.disabled = false;
    button.textContent = 'Save Student to Database';
  }
});


