let selected=null,sort='due',listMode='collect',payMode='Cash',vis='hidden';
function money(n){return '₹'+Number(n).q=$('topSearch').value.trim().toLowerCase();let rows=students.filter(s=>(s.name+' '+s.id+' '+s.className).toLowerCase().includes(q));if(sort==='due')rows.sort((a,b)=>b.due-a.due);else if(sort==='days')rows.sort((a,b)=>b.days-a.days);else rows.sort((a,b)=>a.likely-b.likely);$('studentList').innerHTML='';$('noStudents').style.display=rows.length?'none':'block';rows.forEach(s=>{const d=document.createElement('article');d.className='student'+(selected?.id===s.id?' selected':'');const status=s.days<0?`<span class="badge today">Due in ${Math.abs(s.days)} days</span>`:s.days===0?'<span class="badge today">Due today</span>':`<span class="badge">${s.days} days overdue</span>`;d.innerHTML=`<div class="studenttop"><div><div class="studentname">${s.name}${status}</div><div class="studentmeta">Class ${s.className} · ${s.id} · Due date ${new Date(s.dueDate+'T12:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'short'})} · Last: ${s.last}</div></div><div class="due">${money(s.due)}</div></div><div class="studentactions"><button class="actionbtn primarybtn" data-action="payment" data-id="${s.id}">Record payment</button><button class="actionbtn" data-action="call" data-id="${s.id}">☎ Call parent</button><button class="actionbtn" data-action="reminder" data-id="${s.id}">Send reminder</button></div></div>`;$('studentList').appendChild(d)});}
function selectStudent(id,action){selected=students.find(s=>s.id===id)||null;renderStudents();if(!selected)return;$('paymentHint').style.display='none';$('paymentFields').style.display='block';$('paymentWho').textContent=`${selected.name} · Class ${selected.className} · Due ${money(selected.due)}`;$('amount').value=selected.due;$('allocation').value=`${selected.name} (due ${money(selected.due)})`;$('parentWho').textContent=`${selected.family} · ${selected.name}, Class ${selected.className} · Due ${money(selected.due)}`;$('reminderWho').textContent=`${selected.name} · ${selected.id} · Outstanding ${money(selected.due)}`;$('promiseAmount').value=selected.due;$('phoneDisplay').textContent=vis==='visible'?'Demo preview: phone numbers are not included in this file.':'Parent phone number remains hidden in this preview.';if(action==='call')$('parentPanel').scrollIntoView({behavior:'smooth',block:'nearest'});else if(action==='payment')$('paymentPanel').scrollIntoView({behavior:'smooth',block:'nearest'});else if(action==='reminder')$('sendReminder').scrollIntoView({behavior:'smooth',block:'nearest'});}
$('studentList').addEventListener('click',e=>{const b=e.target.closest('button[data-action]');if(b)selectStudent(b.dataset.id,b.dataset.action)});
$('topSearch').addEventListener('input',renderStudents);
document.querySelectorAll('[data-sort]').forEach(b=>b.onclick=()=>{sort=b.dataset.sort;document.querySelectorAll('[data-sort]').forEach(x=>x.classList.toggle('active',x===b));renderStudents()});document.querySelectorAll('[data-listmode]').forEach(b=>b.onclick=()=>{listMode=b.dataset.listmode;document.querySelectorAll('[data-listmode]').forEach(x=>x.classList.toggle('active',x===b));$('listDescription').textContent=listMode==='class'?'Class view preview. Choose a class in the full application.':'Top students by your selected sort. Fees only.';renderStudents()});
document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{payMode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b));$('utrField').style.display=payMode==='Cash'?'none':'block'});
document.querySelectorAll('[data-vis]').forEach(b=>b.onclick=()=>{vis=b.dataset.vis;document.querySelectorAll('[data-vis]').forEach(x=>x.classList.toggle('active',x===b));$('phoneDisplay').textContent=vis==='visible'?'Demo preview: phone numbers are not included in this file.':vis==='masked'?'Parent phone number would be masked in the real application.':'Parent phone number remains hidden in this preview.';notify('Contact visibility preview changed to '+vis+'.')});
$('postPayment').onclick=()=>{if(!selected)return notify('Select a student first.');const amount=Number($('amount').value);if(!Number.isFinite(amount)||amount<=0)return notify('Enter a valid payment amount.');if(payMode!=='Cash'&&!/^\d{12}$/.test($('utr').value.trim()))return notify('Enter the 12-digit UTR for '+payMode+'.');notify('Preview only: payment was not saved. Backend integration is required.')};$('startCall').onclick=()=>notify('Preview only: no phone call was placed.');$('saveCall').onclick=()=>notify('Preview only: call outcome was not saved.');$('sendReminder').onclick=()=>notify('Preview only: no reminder was sent.');
function answerFor(q){const t=q.toLowerCase();if(/today.?s collection|collection today|collected today/.test(t))return "Today's collection in this preview is ₹0 against a ₹4,50,000 target. This is illustrative data; the live answer must come from the backend.";let s=students.find(x=>t.includes(x.id.toLowerCase())||t.includes(x.name.toLowerCase()));if(s)return `${s.name} (${s.id}) has ${money(s.due)} outstanding in this UI preview. Fee due date: ${s.dueDate}; ${s.days>0?s.days+' days overdue':s.days===0?'due today':'due in '+Math.abs(s.days)+' days'}. This is illustrative data, not a live backend response.`;if(/overdue|outstanding|balance|due amount|fees/.test(t))return 'This preview contains illustrative fee records only. Connect the backend API to calculate an accurate total for this question.';return 'Copilot UI preview is ready, but this standalone HTML has no connection to Avinash’s AI backend. The live request/response integration will be connected in the Laravel application.'}
$('askCopilot').onclick=()=>{const q=$('topSearch').value.trim();if(!q){notify('Type a student name or question first.');$('topSearch').focus();return}const area=$('copilotArea');area.classList.add('show');$('chatBody').innerHTML=`<div class="chatmsg user"><b>You</b><br>${escapeHtml(q)}</div><div class="chatmsg assistant"><b>Copilot · Preview</b><br>${escapeHtml(answerFor(q))}</div>`;$('chatError').textContent='';area.scrollIntoView({behavior:'smooth',block:'start'})};$('closeCopilot').onclick=()=>{$('copilotArea').classList.remove('show');$('chatBody').innerHTML='';$('chatError').textContent=''};
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
renderStudents();
</script>
</body>
</html>
const $ = id => document.getElementById(id);

let authToken = null;
let loggedInUser = null;
let otpStage = false;

let selected = null;
let sort = 'due';
let listMode = 'collect';
let payMode = 'Cash';
let vis = 'hidden';

/* =========================================================
   NOTIFICATIONS AND API REQUESTS
========================================================= */

function notify(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.add('show');

  clearTimeout(window._toastTimer);

  window._toastTimer = setTimeout(() => {
    t.classList.remove('show');
  }, 3200);
}

async function apiRequest(path, options = {}) {
  const headers = {
    Accept: 'application/json',
    'Content-Type': 'application/json',
    ...(authToken
      ? { Authorization: 'Bearer ' + authToken }
      : {}),
    ...(options.headers || {})
  };

  const response = await fetch(path, {
    ...options,
    headers
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    if (response.status === 401 && authToken) {
      authToken = null;
      loggedInUser = null;
      setScreen('login');
    }

    throw new Error(
      data.message || 'Request failed. Please try again.'
    );
  }

  return data;
}

/* =========================================================
   SCREEN NAVIGATION
========================================================= */

function setScreen(which) {
  if (which === 'accountant' && !authToken) {
    $('loginStatus').className = 'status show error';
    $('loginStatus').textContent =
      'Please sign in with your registered mobile number first.';

    which = 'login';
  }

  $('loginScreen').classList.toggle(
    'active',
    which === 'login'
  );

  $('accountantScreen').classList.toggle(
    'active',
    which === 'accountant'
  );

  $('showLogin').classList.toggle(
    'active',
    which === 'login'
  );

  $('showAccountant').classList.toggle(
    'active',
    which === 'accountant'
  );

  window.scrollTo({
    top: 0,
    behavior: 'smooth'
  });
}

$('showLogin').onclick = () => {
  if (authToken) {
    if (confirm('Log out of the accountant session?')) {
      logout();
    }
  } else {
    setScreen('login');
  }
};

$('showAccountant').onclick = () => {
  setScreen('accountant');
};

$('previewDashboard').onclick = () => {
  setScreen('accountant');
};

/* =========================================================
   OTP LOGIN
========================================================= */

function resetLogin() {
  otpStage = false;

  $('phone').readOnly = false;
  $('otp').value = '';

  $('otpWrap').style.display = 'none';
  $('otpActions').style.display = 'none';

  $('submitLogin').textContent = 'Send OTP';

  $('loginHeading').textContent = 'Welcome Back';

  $('loginSubtext').textContent =
    'Sign in using your registered mobile number.';

  $('loginStatus').className = 'status';
}

$('loginForm').addEventListener('submit', async e => {
  e.preventDefault();

  const phone = $('phone').value.replace(/\D/g, '');
  const otp = $('otp').value.trim();
  const status = $('loginStatus');
  const submit = $('submitLogin');

  if (!/^[6-9]\d{9}$/.test(phone)) {
    status.className = 'status show error';
    status.textContent =
      'Enter a valid 10-digit mobile number.';
    return;
  }

  status.className = 'status show info';

  status.textContent = otpStage
    ? 'Verifying OTP...'
    : 'Requesting OTP...';

  submit.disabled = true;

  try {
    if (!otpStage) {
      // STEP 1: Request OTP from Laravel.
      await apiRequest('/api/login/send-otp', {
        method: 'POST',
        body: JSON.stringify({
          mobile: phone
        })
      });

      otpStage = true;

      $('phone').readOnly = true;
      $('otpWrap').style.display = 'block';
      $('otpActions').style.display = 'flex';

      submit.textContent = 'Verify OTP';

      $('loginHeading').textContent =
        'Verify your mobile number';

      $('loginSubtext').textContent =
        'Enter the six-digit OTP from your configured delivery method.';

      status.className = 'status show info';

      status.textContent =
        'OTP requested. For local development, check the Laravel log. SMS delivery is not configured yet.';

    } else {
      // STEP 2: Validate OTP input.
      if (!/^\d{6}$/.test(otp)) {
        throw new Error('Enter the six-digit OTP.');
      }

      // STEP 3: Verify OTP with Laravel.
      const data = await apiRequest(
        '/api/login/verify-otp',
        {
          method: 'POST',
          body: JSON.stringify({
            mobile: phone,
            otp: otp
          })
        }
      );

      // STEP 4: Store the returned token in memory.
      authToken = data.token;
      loggedInUser = data.user;

      status.className = 'status show info';
      status.textContent =
        'Login successful. Loading accountant dashboard...';

      // STEP 5: Open the authenticated dashboard.
      setScreen('accountant');

      // STEP 6: Request dashboard data from Laravel.
      try {
        const dashboard = await apiRequest(
          '/api/accountant/dashboard'
        );

        console.log(
          'Authenticated user:',
          loggedInUser
        );

        console.log(
          'Dashboard API response:',
          dashboard
        );

        notify(
          'Signed in successfully. Dashboard API connected.'
        );

      } catch (dashboardError) {
        console.error(
          'Dashboard API error:',
          dashboardError
        );

        notify(
          'Login succeeded, but dashboard API failed: ' +
          dashboardError.message
        );
      }
    }

  } catch (error) {
    status.className = 'status show error';
    status.textContent = error.message;

  } finally {
    submit.disabled = false;
  }
});

// Change mobile number and restart login.
$('changeNumber').onclick = () => {
  resetLogin();
  $('loginStatus').className = 'status';
};

// Request another OTP.
$('resendOtp').onclick = async () => {
  const phone = $('phone').value.replace(/\D/g, '');
  const status = $('loginStatus');

  status.className = 'status show info';
  status.textContent = 'Requesting a new OTP...';

  try {
    await apiRequest('/api/login/send-otp', {
      method: 'POST',
      body: JSON.stringify({
        mobile: phone
      })
    });

    $('otp').value = '';

    status.textContent =
      'New OTP requested. Check the Laravel log in local development.';

  } catch (error) {
    status.className = 'status show error';
    status.textContent = error.message;
  }
};

/* =========================================================
   LOGOUT
========================================================= */

async function logout() {
  try {
    if (authToken) {
      await apiRequest('/api/logout', {
        method: 'POST'
      });
    }

  } catch (error) {
    console.error('Logout API error:', error);

  } finally {
    authToken = null;
    loggedInUser = null;

    $('phone').value = '';

    resetLogin();
    setScreen('login');

    notify('Logged out.');
  }
}

