/* =========================================================
   STUDENT LIST
========================================================= */

function money(n) {
  return '₹' + Number(n).toLocaleString('en-IN');
}

function renderStudents() {
  const q = $('topSearch').value.trim().toLowerCase();

  let rows = students.filter(s =>
    (s.name + ' ' + s.id + ' ' + s.className)
      .toLowerCase()
      .includes(q)
  );

  if (sort === 'due') {
    rows.sort((a, b) => b.due - a.due);
  } else if (sort === 'days') {
    rows.sort((a, b) => b.days - a.days);
  } else {
    rows.sort((a, b) => a.likely - b.likely);
  }

  $('studentList').innerHTML = '';

  $('noStudents').style.display =
    rows.length ? 'none' : 'block';

  rows.forEach(s => {
    const d = document.createElement('article');

    d.className =
      'student' +
      (selected?.id === s.id ? ' selected' : '');

    const status = s.days < 0
      ? `<span class="badge today">Due in ${Math.abs(s.days)} days</span>`
      : s.days === 0
        ? '<span class="badge today">Due today</span>'
        : `<span class="badge">${s.days} days overdue</span>`;

    d.innerHTML = `
      <div class="studenttop">
        <div>
          <div class="studentname">
            ${s.name}${status}
          </div>
          <div class="studentmeta">
            Class ${s.className} · ${s.id} ·
            Due date ${new Date(s.dueDate + 'T12:00:00')
              .toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short'
              })} · Last: ${s.last}
          </div>
        </div>
        <div class="due">${money(s.due)}</div>
      </div>

      <div class="studentactions">
        <button class="actionbtn primarybtn"
          data-action="payment"
          data-id="${s.id}">
          Record payment
        </button>

        <button class="actionbtn"
          data-action="call"
          data-id="${s.id}">
          ☎ Call parent
        </button>

        <button class="actionbtn"
          data-action="reminder"
